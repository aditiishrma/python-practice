# RECURSION
# Recursion is basically a function only but when inside a function that same function is called then it is known as "RECURSION"
def factorial(n): # factorial(n)= n* factorial(n-1)
    if(n==0 or n==1):
        return 1
    else:
        return n*factorial(n-1)
n=float(input("Enter the number : "))
print("Number : ",n)
print("Factorial of this number is : ",factorial(n))
n=1
print("Factorial of 1 is : ",factorial(n))

# FIBONACCI SERIES
# Write a pogram to print the Fibonacci sequence
def fibonacci(m):
    if(m<=1):
        return m
    else:
        return fibonacci(m-1) + fibonacci(m-2)
terms=int(input("Enter the number of terms : "))
for i in range(terms):
    print(fibonacci(i))